  <strings>
    <string id="dictator_law_name" text="Loi dictatoriale"/>
    <string id="dictator_law_description"
            text="Le souverain détient seul l'autorité sur les décisions du royaume."/>
    <string id="dictator_law_details"
            text="Les vassaux ne peuvent pas proposer de décisions du royaume.{newline}Les vassaux ne peuvent pas former d'armées.{newline}Prend de l'influence au dirigeant."/>
    <string id="dictator_law_secondary_effects" text="pouvoir centralisé"/>
    <string id="dictator_law_penalty" text="Pénalité de la loi du dictateur"/>
    <string id="dictator_law_settings_name" text="Loi du dictateur"/>
    <string id="dictator_law_settings_penalty_name" text="Pénalité d'influence"/>
    <string id="dictator_law_settings_penalty_hint"
            text="Pénalité d'influence pour le dirigeant lorsque la loi du dictateur est active."/>
    <string id="dictator_law_settings_group" text="Général"/>
    <string id="dictator_law_settings_block_armies" text="Block Vassal Armies"/>
    <string id="dictator_law_settings_block_armies_hint"
            text="If enabled, vassals cannot create their own armies while the law is active."/>
    <string id="dictator_law_settings_block_war" text="Block War Declarations"/>
    <string id="dictator_law_settings_block_war_hint" text="If enabled, vassals cannot propose declaring war."/>
    <string id="dictator_law_settings_block_peace" text="Block Peace Proposals"/>
    <string id="dictator_law_settings_block_peace_hint" text="If enabled, vassals cannot propose making peace."/>
    <string id="dictator_law_settings_block_policy" text="Block Policy Changes"/>
    <string id="dictator_law_settings_block_policy_hint"
            text="If enabled, vassals cannot propose changing kingdom policies."/>
    <string id="dictator_law_settings_block_settlement" text="Block Settlement Claims"/>
    <string id="dictator_law_settings_block_settlement_hint"
            text="If enabled, vassals cannot propose claiming settlements."/>
    <string id="dictator_law_settings_block_expulsion" text="Block Clan Expulsion"/>
    <string id="dictator_law_settings_block_expulsion_hint"
            text="If enabled, vassals cannot propose expelling clans from the kingdom."/>
    <string id="dictator_law_settings_block_king" text="Block King Elections"/>
    <string id="dictator_law_settings_block_king_hint" text="If enabled, vassals cannot propose king elections."/>
    <string id="dictator_law_settings_block_diplomacy" text="Block Alliances and Trade"/>
    <string id="dictator_law_settings_block_diplomacy_hint"
            text="If enabled, vassals cannot propose alliances, trade agreements, or call to war agreements."/>
